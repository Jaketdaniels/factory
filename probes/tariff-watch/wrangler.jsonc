{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "tariff-watch",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-09",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"d1_databases": [
		{
			"binding": "DB",
			// Create per probe: `wrangler d1 create <probe-name>` then paste the id here.
			"database_name": "tariff-watch",
			"database_id": "990448b3-e9d0-4bd9-b9bd-2aa390c0a973",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// Public, non-secret configuration only. Secrets (STRIPE_SECRET_KEY,
		// STRIPE_WEBHOOK_SECRET, ADMIN_TOKEN) go in `.dev.vars` locally and
		// `wrangler secret put <NAME>` in production — never here.
		"APP_BASE_URL": "https://tariff.watch",
		// Pay as you go: graduated metered price (first 30 req/mo free, then
		// US$2 per 1,000) on the tariff_watch_requests billing meter.
		"STRIPE_PRICE_ID": "price_1TgqQ8RtNOtWEuKvqiuGX593",
		"STRIPE_METER_EVENT_NAME": "tariff_watch_requests",
		// Pay-as-you-go keys are billed by the meter, never quota-blocked;
		// this quota is an abuse ceiling only.
		"PRO_MONTHLY_QUOTA": 1000000,
		"FREE_MONTHLY_QUOTA": 30
	},
	// Daily ingest at 14:00 UTC — after the Federal Register's ~6am ET publication.
	"triggers": { "crons": ["0 14 * * *"] },
	// Custom domain (uncomment after registering tariff.watch in this Cloudflare
	// account, then set APP_BASE_URL to https://tariff.watch and redeploy):
	"routes": [{ "pattern": "tariff.watch", "custom_domain": true }]
}
