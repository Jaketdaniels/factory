{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "tariff-watch",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-09",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"d1_databases": [
		{
			"binding": "DB",
			// Create per probe: `wrangler d1 create <probe-name>` then paste the id here.
			"database_name": "tariff-watch",
			"database_id": "990448b3-e9d0-4bd9-b9bd-2aa390c0a973",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// Public, non-secret configuration only. Secrets (STRIPE_SECRET_KEY,
		// STRIPE_WEBHOOK_SECRET, ADMIN_TOKEN) go in `.dev.vars` locally and
		// `wrangler secret put <NAME>` in production — never here.
		"APP_BASE_URL": "https://tariff.watch",
		// Keep live access free while Stripe credit grants and fixed-rate prices
		// are verified end to end. Switch to "paid" after the annual prices are real.
		"BILLING_MODE": "free_launch",
		// Pay as you go: flat US$0.10/call metered price on the
		// tariff_watch_requests meter.
		"STRIPE_PRICE_ID": "price_1Th6raRtNOtWEuKvU7fGbHym",
		"STRIPE_METER_EVENT_NAME": "tariff_watch_requests",
		// Pay-as-you-go keys are billed by the meter, never quota-blocked;
		// this quota is an abuse ceiling only.
		"PRO_MONTHLY_QUOTA": 1000000,
		// Display only ("your first 30 API calls are free"): the offer is
		// delivered as a US$3 promotional credit grant at signup
		// (SIGNUP_CREDIT_CENTS), applied by Stripe to metered usage. Every
		// call reports to the meter; nothing is suppressed app-side.
		"FREE_CALL_ALLOWANCE": 30,
		"SIGNUP_CREDIT_CENTS": 300,
		// Fixed rate - monthly: flat $29/mo licensed price plus a graduated
		// metered price (first 500/month at $0, then $0.10/call) on the same
		// meter. Existing monthly IDs are retained until the new 500-call
		// graduated price is confirmed in Stripe.
		"STRIPE_FIXED_MONTHLY_PRICE_ID": "price_1ThAO2RtNOtWEuKv0LUVQTiV",
		"STRIPE_FIXED_MONTHLY_METERED_PRICE_ID": "price_1ThNg8RtNOtWEuKv2ROZRlIr",
		// Fixed rate - annual: create these in Stripe before switching
		// BILLING_MODE to paid.
		"STRIPE_FIXED_ANNUAL_PRICE_ID": "price_REPLACE_ME",
		"STRIPE_FIXED_ANNUAL_METERED_PRICE_ID": "price_REPLACE_ME",
		"FIXED_MONTHLY_INCLUDED_CALLS": 500,
		"FIXED_ANNUAL_INCLUDED_CALLS": 7500
	},
	// Transactional email (key receipts) via Cloudflare Email Service; the
	// sender domain netm8.com is onboarded for Email Sending on this account.
	"send_email": [{ "name": "EMAIL" }],
	// Free-surface abuse brake: 120 req/min per client IP per Cloudflare
	// location (the binding is per-colo and eventually consistent — an abuse
	// brake, not an accounting system). Config + semantics per
	// https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
	"ratelimits": [{ "name": "FREE_RL", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
	// Ingest four times daily (02/08/14/20 UTC) — the Federal Register
	// publishes ~6am ET (≈10-11 UTC); off-the-hour minute avoids the herd.
	// Multiple/list cron expressions per
	// https://developers.cloudflare.com/workers/configuration/cron-triggers/
	"triggers": { "crons": ["7 2,8,14,20 * * *"] },
	// Custom domain (uncomment after registering tariff.watch in this Cloudflare
	// account, then set APP_BASE_URL to https://tariff.watch and redeploy):
	"routes": [{ "pattern": "tariff.watch", "custom_domain": true }]
}
