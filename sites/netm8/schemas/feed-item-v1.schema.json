{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://netm8.com/standards/feed-item-v1.schema.json",
	"title": "FeedItemV1",
	"description": "netm8 canonical change event: one record per detected change in a primary government source. Every delivery format (JSON API, RSS, calendar, webhook, MCP) serializes from this object. Versioned: breaking changes become FeedItemV2 at a new URL.",
	"type": "object",
	"required": ["id", "source", "classification", "status", "dates", "summary", "provenance", "delivery"],
	"properties": {
		"id": {
			"type": "string",
			"description": "Stable unique id for the change event (not the document: a corrected document yields a new event)."
		},
		"source": {
			"type": "object",
			"required": ["name", "type", "jurisdiction", "authority", "source_url"],
			"properties": {
				"name": {
					"type": "string",
					"description": "Human-readable source name."
				},
				"type": {
					"type": "string",
					"description": "Source class: government, regulator, customs, court, registry."
				},
				"jurisdiction": {
					"type": "string",
					"description": "Country, state, province, or region."
				},
				"authority": {
					"type": "string",
					"description": "Issuing body."
				},
				"publisher": {
					"type": "string",
					"description": "Organization hosting the content."
				},
				"source_url": {
					"type": "string",
					"format": "uri",
					"description": "Primary document URL."
				},
				"source_version_url": {
					"type": "string",
					"format": "uri",
					"description": "Version-specific URL where the source provides one."
				},
				"source_id": {
					"type": "string",
					"description": "The source's own identifier (e.g. Federal Register document number)."
				},
				"license_note": {
					"type": "string",
					"description": "Reuse basis for this source: public domain (e.g. 17 U.S.C. \u00a7105), open government license with attribution, or explicit dedication. Required by the netm8 license gate when the basis is not US public domain."
				}
			}
		},
		"classification": {
			"type": "object",
			"required": ["category"],
			"properties": {
				"category": {
					"type": "string",
					"description": "Feed-level category (e.g. tariff program)."
				},
				"subtype": {
					"type": "string"
				},
				"topics": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"tags": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		},
		"status": {
			"type": "object",
			"required": ["state", "change_type"],
			"properties": {
				"state": {
					"type": "string",
					"enum": ["new", "updated", "scheduled", "effective", "superseded", "withdrawn", "corrected", "archived"],
					"description": "Record lifecycle state \u2014 what the record did. Domain feeds may carry an additional domain status (e.g. legal status) in classification."
				},
				"change_type": {
					"type": "string",
					"description": "What changed: created, amended, corrected, withdrawn, metadata."
				},
				"is_new": {
					"type": "boolean"
				},
				"is_updated": {
					"type": "boolean"
				},
				"is_withdrawn": {
					"type": "boolean"
				},
				"is_corrected": {
					"type": "boolean"
				}
			}
		},
		"dates": {
			"type": "object",
			"required": ["published_at", "retrieved_at", "detected_at"],
			"properties": {
				"published_at": {
					"type": "string",
					"format": "date-time"
				},
				"effective_at": {
					"type": ["string", "null"],
					"format": "date-time"
				},
				"updated_at": {
					"type": ["string", "null"],
					"format": "date-time"
				},
				"retrieved_at": {
					"type": "string",
					"format": "date-time"
				},
				"detected_at": {
					"type": "string",
					"format": "date-time"
				},
				"expires_at": {
					"type": ["string", "null"],
					"format": "date-time"
				}
			}
		},
		"summary": {
			"type": "object",
			"required": ["title"],
			"properties": {
				"title": {
					"type": "string"
				},
				"abstract": {
					"type": ["string", "null"],
					"description": "Source-supplied abstract where one exists; never fabricated."
				},
				"short_summary": {
					"type": ["string", "null"],
					"description": "Our own one-line summary."
				},
				"long_summary": {
					"type": ["string", "null"]
				}
			}
		},
		"change_tracking": {
			"type": "object",
			"properties": {
				"version": {
					"type": "string"
				},
				"previous_version": {
					"type": ["string", "null"]
				},
				"diff_summary": {
					"type": ["string", "null"]
				},
				"diff_fields": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"change_severity": {
					"type": "string",
					"enum": ["info", "minor", "major", "critical"]
				},
				"change_notes": {
					"type": ["string", "null"]
				}
			}
		},
		"provenance": {
			"type": "object",
			"required": ["primary_source_url", "retrieval_method"],
			"properties": {
				"primary_source_url": {
					"type": "string",
					"format": "uri"
				},
				"snapshot_url": {
					"type": ["string", "null"],
					"format": "uri",
					"description": "Immutable dated snapshot containing this record."
				},
				"snapshot_hash": {
					"type": ["string", "null"],
					"description": "SHA-256 of the raw retrieved content."
				},
				"retrieval_method": {
					"type": "string",
					"description": "official_api, bulk_data, rss, or managed_scrape \u2014 netm8 collection is API-first; scraping is the fallback tier."
				},
				"parser_version": {
					"type": ["string", "null"]
				},
				"confidence": {
					"type": "number",
					"minimum": 0,
					"maximum": 1,
					"description": "Classifier confidence; statuses are inferred only from signals the source carries."
				}
			}
		},
		"delivery": {
			"type": "object",
			"required": ["canonical_url"],
			"properties": {
				"canonical_url": {
					"type": "string",
					"format": "uri"
				},
				"rss_guid": {
					"type": ["string", "null"]
				},
				"calendar_uid": {
					"type": ["string", "null"]
				},
				"webhook_event": {
					"type": ["string", "null"]
				}
			}
		},
		"metrics": {
			"type": "object",
			"properties": {
				"importance_score": {
					"type": "number"
				},
				"recency_score": {
					"type": "number"
				},
				"volatility_score": {
					"type": "number"
				},
				"confidence_score": {
					"type": "number"
				}
			}
		},
		"raw": {
			"type": "object",
			"properties": {
				"content_type": {
					"type": ["string", "null"]
				},
				"raw_snapshot_ref": {
					"type": ["string", "null"],
					"description": "Object-storage reference to the raw retrieved bytes, keyed by snapshot_hash."
				}
			}
		}
	}
}
